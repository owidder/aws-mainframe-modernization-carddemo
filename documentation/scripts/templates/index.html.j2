<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CardDemo – Program Documentation</title>
  <style>
    :root {
      --bg:#1e1e2e; --bg2:#181825; --bg3:#313244; --border:#45475a;
      --text:#cdd6f4; --subtext:#a6adc8; --comment:#6c7086;
      --keyword:#cba6f7; --string:#a6e3a1; --gold:#f9e2af; --cyan:#89dceb;
    }
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    body { background:var(--bg); color:var(--text); font-family:'Segoe UI',system-ui,sans-serif; padding:2rem; }
    h1 { color:var(--gold); font-size:2rem; margin-bottom:.5rem; }
    .subtitle { color:var(--subtext); margin-bottom:2rem; }
    .topnav { margin-bottom:1.5rem; }
    .topnav a {
      display:inline-block; padding:.35rem .9rem; background:var(--bg2);
      border:1px solid var(--border); border-radius:.35rem;
      color:var(--cyan); text-decoration:none; font-size:.82rem;
    }
    .topnav a:hover { border-color:var(--cyan); background:var(--bg3); }
    .stats { display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:2rem; }
    .stat { background:var(--bg2); border:1px solid var(--border); border-radius:.5rem; padding:.75rem 1.25rem; }
    .stat-n { font-size:1.8rem; font-weight:700; color:var(--gold); }
    .stat-l { font-size:.75rem; color:var(--subtext); text-transform:uppercase; letter-spacing:.05em; }
    .group { margin-bottom:2rem; }
    .group-title {
      font-size:1rem; font-weight:700; color:var(--string);
      padding:.4rem 0; border-bottom:1px solid var(--border); margin-bottom:.75rem;
    }
    .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:.75rem; }
    .card {
      background:var(--bg2); border:1px solid var(--border); border-radius:.5rem;
      padding:1rem 1.25rem; text-decoration:none; color:inherit;
      transition:border-color .15s, background .15s;
    }
    .card:hover { border-color:var(--cyan); background:var(--bg3); }
    .card-name { font-family:monospace; font-size:1rem; color:var(--cyan); font-weight:700; }
    .card-desc { font-size:.82rem; color:var(--subtext); margin-top:.3rem; line-height:1.4; }
    .card-meta { font-size:.72rem; color:var(--comment); margin-top:.5rem; }
    .badge {
      display:inline-block; padding:.15rem .5rem; border-radius:1rem;
      font-size:.7rem; font-weight:600; margin-right:.3rem;
    }
    .b-cics  { background:#1e3a5f; color:#89b4fa; }
    .b-batch { background:#1a3324; color:var(--string); }
    .b-util  { background:#2d2d1b; color:var(--gold); }
    footer { margin-top:3rem; color:var(--comment); font-size:.75rem; }
  </style>
</head>
<body>
  <h1>CardDemo – Program Documentation</h1>
  <p class="subtitle">Automatically generated COBOL source code analysis &middot; {{ generated_at }}</p>

  <div class="topnav">
    <a href="../analysis/index.html">📄 Analysis Documents →</a>
    <a href="status/index.html" style="margin-left:.5rem;">📊 Documentation Status →</a>
  </div>

  <div class="stats">
    <div class="stat"><div class="stat-n">{{ programs | length }}</div><div class="stat-l">Programs</div></div>
    <div class="stat"><div class="stat-n">{{ modules | length }}</div><div class="stat-l">Modules</div></div>
  </div>

  {% for module_name, progs in modules.items() %}
  <div class="group">
    <div class="group-title">{{ module_name }}</div>
    <div class="cards">
      {% for p in progs %}
      <a class="card" href="{{ p.filename }}">
        <div class="card-name">{{ p.program_name }}</div>
        <div class="card-desc">{{ p.description }}</div>
        <div class="card-meta">
          <span class="badge {{ 'b-cics' if 'CICS' in p.type else ('b-batch' if 'Batch' in p.type else 'b-util') }}">{{ p.type }}</span>
          {{ p.lines }} lines &middot; {{ p.variables }} variables &middot; {{ p.paragraphs }} paragraphs
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endfor %}

  <footer>Generated by <code>generate_html.py</code> &middot; CardDemo Mainframe Modernization</footer>
</body>
</html>
