<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ doc.meta.program_name }} – CardDemo Documentation</title>
  <style>
    :root {
      --bg:        #1e1e2e;
      --bg2:       #181825;
      --bg3:       #313244;
      --border:    #45475a;
      --text:      #cdd6f4;
      --subtext:   #a6adc8;
      --comment:   #6c7086;
      --keyword:   #cba6f7;
      --string:    #a6e3a1;
      --number:    #fab387;
      --expl:      #89dceb;
      --gold:      #f9e2af;
      --cyan:      #89dceb;
      --red:       #f38ba8;
      --sidebar-w: 280px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; display: flex; min-height: 100vh; }

    /* ── Sidebar ─────────────────────────────────── */
    #sidebar {
      width: var(--sidebar-w);
      min-width: var(--sidebar-w);
      background: var(--bg2);
      border-right: 1px solid var(--border);
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 1rem 0;
      flex-shrink: 0;
    }
    #sidebar h2 {
      font-size: .7rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--subtext);
      padding: .5rem 1rem .2rem;
      margin-top: .8rem;
    }
    #sidebar a {
      display: block;
      padding: .25rem 1rem;
      color: var(--text);
      text-decoration: none;
      font-size: .82rem;
      font-family: monospace;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #sidebar a:hover { background: var(--bg3); color: var(--cyan); }
    #sidebar .logo {
      font-size: 1rem;
      font-weight: 700;
      color: var(--gold);
      padding: .5rem 1rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    #sidebar .logo span { display: block; font-size: .72rem; color: var(--subtext); font-weight: 400; margin-top: .2rem; }

    /* ── Main ────────────────────────────────────── */
    #main { flex: 1; overflow-x: auto; padding: 2rem; max-width: 100%; }

    /* ── Header ──────────────────────────────────── */
    .prog-header {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: .6rem;
      padding: 1.5rem 2rem;
      margin-bottom: 2rem;
    }
    .prog-header h1 { font-family: monospace; font-size: 1.8rem; color: var(--gold); }
    .prog-header p  { color: var(--subtext); margin-top: .5rem; line-height: 1.5; }
    .badges { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1rem; }
    .badge {
      display: inline-block;
      padding: .25rem .75rem;
      border-radius: 1rem;
      font-size: .75rem;
      font-weight: 600;
    }
    .badge-type   { background: #1e3a5f; color: #89b4fa; border: 1px solid #89b4fa44; }
    .badge-module { background: #2d1b4e; color: var(--keyword); border: 1px solid #cba6f744; }
    .badge-copy   { background: #1a3324; color: var(--string); border: 1px solid #a6e3a144; }
    .badge-meta   { background: var(--bg3); color: var(--subtext); border: 1px solid var(--border); }

    /* ── Section titles ──────────────────────────── */
    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--gold);
      margin: 2rem 0 1rem;
      padding-bottom: .4rem;
      border-bottom: 1px solid var(--border);
    }

    /* ── Code view ───────────────────────────────── */
    .code-table {
      width: 100%;
      border-collapse: collapse;
      font-family: 'Cascadia Code', 'Fira Code', 'Courier New', monospace;
      font-size: .8rem;
    }
    .code-table tr { border-bottom: 1px solid #31324444; }
    .code-table tr:hover { background: #31324422; }
    .code-table tr.division-header { background: #1c1a2a; }
    .code-table tr.section-header  { background: #1a2a1a; }
    .code-table tr.paragraph-header { background: #2a2420; }
    .code-table tr.comment  { opacity: .55; }
    .code-table tr.empty    { height: .4rem; }

    .ln {
      width: 3.5rem;
      text-align: right;
      padding: .1rem .5rem;
      color: var(--comment);
      user-select: none;
      vertical-align: top;
      white-space: nowrap;
    }
    .code-cell {
      padding: .1rem .5rem;
      vertical-align: top;
      white-space: pre;
      max-width: 55ch;
      overflow-x: auto;
    }
    .expl-cell {
      padding: .15rem 1rem .15rem .75rem;
      vertical-align: top;
      color: #cdd6f4;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: .8rem;
      line-height: 1.5;
      max-width: 60ch;
      white-space: normal;
      border-left: 2px solid #45475a44;
    }
    .expl-cell:not(:empty) {
      border-left-color: #89dceb55;
      background: #89dceb08;
    }

    /* Code-Typen einfärben */
    .t-comment         { color: var(--comment); font-style: italic; }
    .t-division-header { color: var(--gold); font-weight: 700; }
    .t-section-header  { color: var(--string); font-weight: 600; }
    .t-paragraph-header{ color: var(--cyan); font-weight: 700; }
    .t-copy-statement  { color: var(--keyword); }
    .t-exec-cics       { color: #f2cdcd; }
    .t-empty           { }
    .t-code, .t-statement, .t-variable-declaration { color: var(--text); }

    /* ── Variables table ─────────────────────────── */
    .var-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .82rem;
    }
    .var-table th {
      background: var(--bg3);
      color: var(--subtext);
      text-align: left;
      padding: .4rem .8rem;
      font-weight: 600;
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .05em;
      border-bottom: 1px solid var(--border);
    }
    .var-table td {
      padding: .4rem .8rem;
      border-bottom: 1px solid #31324444;
      vertical-align: top;
    }
    .var-table tr:hover td { background: #31324422; }
    .var-name { font-family: monospace; color: var(--cyan); font-weight: 600; }
    .var-level { font-family: monospace; color: var(--number); }
    .var-pic   { font-family: monospace; color: var(--string); font-size: .75rem; }
    .var-group { color: var(--keyword); font-size: .72rem; }
    .var-desc  { color: var(--text); line-height: 1.4; }

    /* ── Paragraph cards ─────────────────────────── */
    .para-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: .5rem;
      padding: 1rem 1.5rem;
      margin-bottom: .75rem;
    }
    .para-card h3 {
      font-family: monospace;
      color: var(--cyan);
      font-size: .95rem;
    }
    .para-card p { color: var(--subtext); font-size: .85rem; margin-top: .3rem; line-height: 1.4; }
    .para-card .para-meta { color: var(--comment); font-size: .72rem; margin-top: .3rem; }

    /* ── Footer ──────────────────────────────────── */
    footer {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      color: var(--comment);
      font-size: .75rem;
    }

    @media print {
      #sidebar { display: none; }
      #main { padding: .5rem; }
    }
  </style>
</head>
<body>

<!-- ── Sidebar ─────────────────────────────────────────── -->
<nav id="sidebar">
  <div class="logo">
    CardDemo
    <span>Mainframe Documentation</span>
  </div>

  <a href="index.html" style="color:var(--subtext);margin-top:.5rem;">← Program Overview</a>
  <a href="../analysis/index.html" style="color:var(--subtext);">📄 Analysis Docs</a>

  {% if doc.paragraphs %}
  <h2>Paragraphs</h2>
  {% for p in doc.paragraphs %}
  <a href="#para-{{ p.name }}">{{ p.name }}</a>
  {% endfor %}
  {% endif %}

  {% if doc.variables %}
  <h2>Variables ({{ doc.variables | length }})</h2>
  {% for v in doc.variables[:40] %}
  <a href="#var-{{ v.name }}">{{ v.name }}</a>
  {% endfor %}
  {% if doc.variables | length > 40 %}
  <a style="color:var(--comment);font-style:italic;">… and {{ doc.variables | length - 40 }} more</a>
  {% endif %}
  {% endif %}
</nav>

<!-- ── Main ────────────────────────────────────────────── -->
<main id="main">

  <!-- Header -->
  <div class="prog-header">
    <h1>{{ doc.meta.program_name }}.CBL</h1>
    <p>{{ doc.meta.description }}</p>
    {% if doc.meta.process_description %}
    <p style="margin-top:.5rem;color:var(--text);font-size:.9rem;line-height:1.6;">{{ doc.meta.process_description }}</p>
    {% endif %}
    {% if doc.meta.business_rules %}
    <div style="margin-top:1rem;padding:.75rem 1rem;background:var(--bg3);border-radius:.4rem;border-left:3px solid var(--gold);">
      <div style="font-size:.72rem;text-transform:uppercase;color:var(--gold);letter-spacing:.08em;margin-bottom:.4rem;">Business Rules</div>
      <ul style="margin:0;padding-left:1.2rem;color:var(--subtext);font-size:.83rem;line-height:1.6;">
        {% for rule in doc.meta.business_rules %}<li>{{ rule }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if doc.meta.files %}
    <div style="margin-top:.75rem;padding:.75rem 1rem;background:var(--bg3);border-radius:.4rem;border-left:3px solid var(--string);">
      <div style="font-size:.72rem;text-transform:uppercase;color:var(--string);letter-spacing:.08em;margin-bottom:.4rem;">Files / Data Sources</div>
      <table style="width:100%;border-collapse:collapse;font-size:.82rem;">
        {% for fname, fdesc in doc.meta.files.items() %}
        <tr><td style="font-family:monospace;color:var(--cyan);padding:.1rem .5rem .1rem 0;white-space:nowrap;">{{ fname }}</td>
            <td style="color:var(--subtext);">{{ fdesc }}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}
    <div class="badges">
      <span class="badge badge-type">{{ doc.meta.type }}</span>
      <span class="badge badge-module">{{ doc.meta.module }}</span>
      {% for cb in doc.copybooks %}
      <span class="badge badge-copy">COPY {{ cb }}</span>
      {% endfor %}
      <span class="badge badge-meta">{{ doc.lines | length }} lines</span>
      <span class="badge badge-meta">{{ doc.variables | length }} variables</span>
      <span class="badge badge-meta">{{ doc.paragraphs | length }} paragraphs</span>
      <span class="badge badge-meta">Analyzed: {{ doc.meta.analyzed_at[:10] }}</span>
    </div>
  </div>

  <!-- Paragraph Overview -->
  {% if doc.paragraphs %}
  <div class="section-title">Paragraph Overview</div>
  {% for p in doc.paragraphs %}
  <div class="para-card" id="para-{{ p.name }}">
    <h3>{{ p.name }}</h3>
    {% if p.description %}<p>{{ p.description }}</p>{% endif %}
    <div class="para-meta">Lines {{ p.line_start }}–{{ p.line_end }}</div>
  </div>
  {% endfor %}
  {% endif %}

  <!-- Source Code with Annotations -->
  <div class="section-title">Source Code with Annotations</div>
  <table class="code-table" aria-label="COBOL Source Code">
    <tbody>
    {% for line in doc.lines %}
    <tr class="{{ line.type }}"
        {% if line.paragraph %}id="code-para-{{ line.paragraph }}"{% endif %}>
      <td class="ln">{{ line.number }}</td>
      <td class="code-cell t-{{ line.type }}">{{ line.code }}</td>
      <td class="expl-cell">
        {%- if line.explanation %}{{ line.explanation }}{% endif -%}
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>

  <!-- Variables Glossary -->
  {% if doc.variables %}
  <div class="section-title" style="margin-top:3rem;">Variables &amp; Data Structures</div>
  <table class="var-table">
    <thead>
      <tr>
        <th>Level</th>
        <th>Name</th>
        <th>PIC</th>
        <th>Value</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
    {% for v in doc.variables %}
    <tr id="var-{{ v.name }}">
      <td class="var-level">{{ v.level or '' }}</td>
      <td class="var-name">{{ v.name }}
        {% if v.is_group %}<br><span class="var-group">Group field</span>{% endif %}
        {% if v.redefines %}<br><span class="var-group">REDEFINES {{ v.redefines }}</span>{% endif %}
      </td>
      <td class="var-pic">{{ v.picture or '–' }}</td>
      <td class="var-pic">{{ v.value or '–' }}</td>
      <td class="var-desc">{{ v.description }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <footer>
    Generated by <code>generate_html.py</code> &middot; Model: {{ doc.meta.model }} &middot;
    File: {{ doc.meta.file_path }}
  </footer>

</main>
</body>
</html>
