<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title }} – CardDemo Analysis</title>
  <style>
    :root {
      --bg:        #eff1f5;
      --bg2:       #e6e9ef;
      --bg3:       #ccd0da;
      --border:    #acb0c4;
      --text:      #1a1c2e;
      --subtext:   #383a58;
      --comment:   #52546e;
      --keyword:   #5c15c4;
      --string:    #1d6010;
      --number:    #b84000;
      --cyan:      #0069b4;
      --gold:      #8b5e00;
      --red:       #b5002a;
      --blue:      #1040b8;
      --sidebar-w: 272px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      display: flex;
      min-height: 100vh;
      font-size: 14px;
      line-height: 1.65;
    }

    /* ── Sidebar ─────────────────────────────────── */
    #sidebar {
      width: var(--sidebar-w);
      min-width: var(--sidebar-w);
      background: var(--bg2);
      border-right: 1px solid var(--border);
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding-bottom: 2rem;
      flex-shrink: 0;
    }
    .sidebar-logo {
      padding: 1.1rem 1.1rem .9rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-logo .brand { font-size: 1rem; font-weight: 700; color: var(--gold); }
    .sidebar-logo .sub   { font-size: .72rem; color: var(--subtext); margin-top: .15rem; }

    #sidebar h2 {
      font-size: .68rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--subtext);
      padding: .9rem 1.1rem .25rem;
    }
    #sidebar a {
      display: block;
      padding: .28rem 1.1rem;
      color: var(--text);
      text-decoration: none;
      font-size: .8rem;
      border-left: 2px solid transparent;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #sidebar a:hover { color: var(--cyan); background: rgba(0,105,180,.06); }
    #sidebar a.active {
      color: var(--cyan);
      border-left-color: var(--cyan);
      background: rgba(0,105,180,.1);
      font-weight: 600;
    }
    #sidebar a.toc-h3 { padding-left: 1.9rem; font-size: .75rem; color: var(--subtext); }
    #sidebar a.toc-h3:hover { color: var(--cyan); }
    .sidebar-divider { border: none; border-top: 1px solid var(--border); margin: .4rem 0; }

    /* ── Main ────────────────────────────────────── */
    #main {
      flex: 1;
      padding: 2.2rem 3rem;
      max-width: 920px;
      overflow-x: hidden;
    }

    /* ── Breadcrumb ──────────────────────────────── */
    .breadcrumb {
      font-size: .75rem;
      color: var(--comment);
      margin-bottom: 1.6rem;
    }
    .breadcrumb a { color: var(--subtext); text-decoration: none; }
    .breadcrumb a:hover { color: var(--cyan); }
    .breadcrumb span { color: var(--comment); margin: 0 .4rem; }

    /* ── Markdown content ────────────────────────── */
    #content h1 {
      font-size: 1.7rem;
      color: var(--gold);
      border-bottom: 1px solid var(--border);
      padding-bottom: .5rem;
      margin-bottom: 1.4rem;
    }
    #content h2 {
      font-size: 1.15rem;
      color: var(--blue);
      margin: 2.2rem 0 .8rem;
      padding-bottom: .3rem;
      border-bottom: 1px solid var(--border);
    }
    #content h3 {
      font-size: .97rem;
      color: var(--cyan);
      margin: 1.5rem 0 .5rem;
    }
    #content h4 {
      font-size: .88rem;
      color: var(--keyword);
      margin: 1.1rem 0 .4rem;
      font-weight: 600;
    }
    #content p { margin-bottom: .85rem; }
    #content ul, #content ol {
      margin: .5rem 0 .85rem 1.4rem;
    }
    #content li { margin-bottom: .25rem; }

    /* Tables */
    #content table {
      border-collapse: collapse;
      width: 100%;
      margin: 1rem 0 1.5rem;
      font-size: .82rem;
    }
    #content th {
      background: var(--bg3);
      color: var(--subtext);
      padding: .45rem .8rem;
      text-align: left;
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .05em;
      font-weight: 600;
      border-bottom: 1px solid var(--border);
    }
    #content td {
      padding: .42rem .8rem;
      border-bottom: 1px solid #ccd0da55;
      vertical-align: top;
    }
    #content tr:hover td { background: rgba(0,105,180,.04); }

    /* Code */
    #content pre {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: .45rem;
      padding: 1rem 1.2rem;
      overflow-x: auto;
      font-size: .79rem;
      line-height: 1.6;
      margin: .8rem 0 1.3rem;
      font-family: 'Cascadia Code','Fira Code','Courier New',monospace;
    }
    #content pre code {
      background: none;
      color: var(--text);
      padding: 0;
      border-radius: 0;
      font-size: inherit;
    }
    #content code {
      background: var(--bg3);
      color: var(--cyan);
      padding: .15rem .4rem;
      border-radius: .25rem;
      font-size: .82em;
      font-family: 'Cascadia Code','Fira Code','Courier New',monospace;
    }

    /* Source references */
    .srcref {
      font-family: 'Cascadia Code','Fira Code','Courier New',monospace;
      font-size: .78rem;
      color: var(--blue);
      background: rgba(16,64,184,.1);
      border: 1px solid rgba(16,64,184,.25);
      padding: .1rem .4rem;
      border-radius: .25rem;
    }

    /* Blockquote */
    #content blockquote {
      border-left: 3px solid var(--blue);
      margin: .8rem 0 1rem;
      padding: .6rem 1rem;
      background: rgba(16,64,184,.07);
      border-radius: 0 .35rem .35rem 0;
      color: var(--subtext);
      font-size: .87rem;
    }

    /* HR */
    #content hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2rem 0;
    }

    /* Links */
    #content a { color: var(--blue); text-decoration: none; }
    #content a:hover { text-decoration: underline; color: var(--cyan); }

    /* ── Footer ──────────────────────────────────── */
    footer {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      color: var(--comment);
      font-size: .72rem;
    }

    @media print {
      #sidebar { display: none; }
      #main { padding: .5rem; max-width: 100%; }
    }

    /* ── COBOL → Java Patterns page: quick-ref, compare panels, notes ── */
    #content #qr-table td:first-child a { color: var(--string); }
    #content #qr-table td:first-child a:hover { color: var(--cyan); }
    #content #qr-table td:nth-child(2) { font-family: inherit; color: var(--subtext); font-size: .8rem; white-space: normal; }
    #content #qr-table td:nth-child(3) { font-family: 'Cascadia Code','Fira Code',monospace; color: var(--blue); font-size: .78rem; }
    #content #qr-table td:nth-child(4) { color: var(--subtext); font-size: .8rem; }
    #content .qr-ref { background: rgba(0,105,180,.05); border-left: 3px solid var(--cyan); border-radius: 0 .35rem .35rem 0; padding: .45rem .9rem .5rem; margin: 0 0 1.1rem; }
    #content .qr-ref-label { font-size: .63rem; text-transform: uppercase; letter-spacing: .09em; color: var(--cyan); font-weight: 700; display: block; margin-bottom: .3rem; }
    #content .qr-ref ul { margin: 0; padding: 0; list-style: none; }
    #content .qr-ref li { margin-bottom: .15rem; color: var(--subtext); font-size: .8rem; }
    #content .qr-ref li code { color: var(--string); background: none; padding: 0; font-size: .78rem; }
    #content .compare { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; margin: .7rem 0 1.6rem; }
    #content .panel { border-radius: .45rem; overflow: hidden; border: 1px solid var(--border); }
    #content .panel-header { display: flex; align-items: center; gap: .5rem; padding: .3rem .75rem; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid var(--border); }
    #content .panel-cobol { border-left: 3px solid var(--string); }
    #content .panel-java  { border-left: 3px solid var(--blue); }
    #content .panel-cobol .panel-header { background: #d8f0d8; color: var(--string); }
    #content .panel-java  .panel-header { background: #d8e8fd; color: var(--blue); }
    #content .panel pre { margin: 0; border: none; border-radius: 0; background: var(--bg2); padding: .85rem 1rem; overflow-x: auto; font-size: .75rem; line-height: 1.55; font-family: 'Cascadia Code','Fira Code','Courier New',monospace; }
    #content .panel pre code { background: none; padding: 0; font-size: 1em; color: var(--text); }
    #content .note { background: rgba(139,94,0,.07); border-left: 3px solid var(--gold); border-radius: 0 .35rem .35rem 0; padding: .6rem 1rem; margin: .6rem 0 1.2rem; font-size: .85rem; color: var(--subtext); }
    #content .note strong { color: var(--gold); }
    #content .warn { background: rgba(181,0,42,.07); border-left: 3px solid var(--red); border-radius: 0 .35rem .35rem 0; padding: .6rem 1rem; margin: .6rem 0 1.2rem; font-size: .85rem; color: var(--subtext); }
    #content .warn strong { color: var(--red); }
    #content .codeblock { background: var(--bg2); border: 1px solid var(--border); border-radius: .45rem; padding: .85rem 1.1rem; overflow-x: auto; margin: .7rem 0 1.4rem; font-family: 'Cascadia Code','Fira Code','Courier New',monospace; font-size: .77rem; line-height: 1.55; }
    #content .codeblock code { background: none; padding: 0; color: var(--text); font-size: 1em; }
  </style>
</head>
<body>

<!-- ── Sidebar ─────────────────────────────────────────── -->
<nav id="sidebar">
  <div class="sidebar-logo">
    <div class="brand">CardDemo</div>
    <div class="sub">Mainframe → Java Analysis</div>
  </div>

  <h2>Analysis Documents</h2>
  {% for nav in nav_pages %}
  <a href="{{ nav.filename }}"
     {% if nav.filename == page.filename %}class="active"{% endif %}>
    {{ nav.title }}
  </a>
  {% endfor %}

  <hr class="sidebar-divider">

  <h2>Program Detail Pages</h2>
  {% for prog in program_pages %}
  <a href="../html/{{ prog.filename }}">{{ prog.name }}</a>
  {% endfor %}

  {% if page.toc %}
  <hr class="sidebar-divider">
  <h2>On this page</h2>
  {% for item in page.toc %}
  <a href="#{{ item.id }}"
     class="{{ 'toc-h3' if item.level == 3 else '' }}">{{ item.text }}</a>
  {% endfor %}
  {% endif %}
</nav>

<!-- ── Main ────────────────────────────────────────────── -->
<main id="main">
  <div class="breadcrumb">
    <a href="index.html">Analysis</a>
    <span>›</span>
    {{ page.title }}
  </div>

  <div id="content">
    {{ page.content_html }}
  </div>

  <footer>
    Generated by <code>generate_analysis.py</code> &middot;
    CardDemo Mainframe Modernization &middot;
    Source: <code>{{ page.source_file }}</code>
  </footer>
</main>

</body>
</html>
